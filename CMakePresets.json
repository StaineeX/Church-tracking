{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "unit-tests",
      "displayName": "OBS/OpenCV-independent unit tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/unit-tests",
      "cacheVariables": {
        "BUILD_OBS_PLUGIN": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "plugin-windows",
      "displayName": "OBS plugin + OpenCV (Windows, Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.22621",
      "binaryDir": "${sourceDir}/build/plugin-windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "BUILD_OBS_PLUGIN": "ON", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "plugin-linux",
      "displayName": "OBS plugin + OpenCV (Linux, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/plugin-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "BUILD_OBS_PLUGIN": "ON", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "plugin-macos",
      "displayName": "OBS plugin + OpenCV (macOS, Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/plugin-macos",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "BUILD_OBS_PLUGIN": "ON", "BUILD_TESTING": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "unit-tests", "configurePreset": "unit-tests" },
    { "name": "plugin-windows", "configurePreset": "plugin-windows", "configuration": "RelWithDebInfo" },
    { "name": "plugin-linux", "configurePreset": "plugin-linux" },
    { "name": "plugin-macos", "configurePreset": "plugin-macos", "configuration": "RelWithDebInfo" }
  ]
}
